#include "custom54.dtsi"

&default_transform {
    col-offset = <5>;
};

&kscan {
    // Column pins for right half (Col 0 through Col 4)
    // Symmetrical to left half.
    col-gpios
        = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Col 0: Inner index
        , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Col 1: Index
        , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Col 2: Middle
        , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Col 3: Ring
        , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // Col 4: Outer pinky
        ;
};
