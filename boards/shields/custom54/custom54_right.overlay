#include "custom54.dtsi"

&default_transform {
    col-offset = <5>;
};

&kscan {
    // Default pro_micro column pins for right half (Col 0 through Col 4)
    // Symmetrical to left half. With row2col, columns are input pins read with pull-downs.
    // Adjust these pins if your hardware wiring differs!
    col-gpios
        = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};
